# ── YouTube Data API v3 (Chrome extension) ───────────────────────────────────
# Get one at console.cloud.google.com
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── OpenAI (optional — proficiency classification) ────────────────────────────
# Falls back to keyword heuristics if blank
OPENAI_API_KEY=your_openai_api_key_here

# ── Spotify Web API (dashboard Spotify integration) ───────────────────────────
# Create an app at developer.spotify.com — add http://localhost:8000/api/spotify/callback
# as a Redirect URI in the app settings
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CACHE_TTL_SECONDS=3600
MAX_RESULTS_PER_TOPIC=5
