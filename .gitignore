```gitignore
# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Pytest
.pytest_cache/

# VS Code
.vscode/

# Logs
*.log
backend_stdout.log
backend_stderr.log

# Environment variables
.env

# OS files
.DS_Store
Thumbs.db

# Python build files
build/
dist/
*.egg-info/

# Node (if ever used)
node_modules/
```
